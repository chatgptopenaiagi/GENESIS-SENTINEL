include LICENSE README.md THEORY.md ARCHITECTURE.md INSTALL.md RECOVERY.md CHANGELOG.md
recursive-include docs *.md
recursive-include examples *.json *.md *.sh *.hook *.py
recursive-include tests *.py
recursive-include tools *.py *.sh
recursive-include src/genesis_sentinel/web-control *.html *.css *.js
prune .qa
prune .release-work
prune dist
prune build
global-exclude __pycache__ *.py[cod] *.log
